# Copia este archivo como .env para desarrollo local o define estas variables en tu hosting.

# URL pública del sitio, sin barra final. En Netlify se toma automáticamente;
# en cualquier otro hosting conviene definirla (se usa en canonical, sitemap, Open Graph y el dossier).
SITE_URL=https://www.ejemplo.com

# Subdirectorio donde se publica el sitio (p. ej. "/velocity-bucks" en GitHub Pages). Vacío = raíz.
BASE_PATH=
